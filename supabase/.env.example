# Copia di riferimento dei "Secrets" da impostare su Supabase
# (Dashboard → Edge Functions → Secrets). NON mettere qui i valori veri
# e NON caricare mai un file con i valori veri su GitHub.
SUMUP_API_KEY=            # SumUp → Developers → API keys (chiave segreta, inizia con sup_sk_)
SUMUP_MERCHANT_CODE=      # SumUp → Profilo → "Merchant code" (es. MXXXXXXX)
BREVO_API_KEY=            # Brevo → SMTP & API → API keys
SENDER_EMAIL=             # mittente verificato su Brevo, es. info@carminello.eu
SENDER_NAME=Carminello
SITE_URL=                 # indirizzo pubblico del sito, es. https://alleysrl.github.io/carminello-shop
WEBHOOK_SECRET=           # parola segreta a piacere, la stessa messa nel Database Webhook
